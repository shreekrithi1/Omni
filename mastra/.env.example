# ---- Model ----
OMNI_MODEL=openai/gpt-4o-mini          # any Mastra model string, e.g. anthropic/claude-sonnet-4-5
OMNI_GUARD_MODEL=openai/gpt-4o-mini    # small, fast model for guardrails
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Security (required in production) ----
OMNI_API_TOKEN=                        # long random string; frontend sends "Authorization: Bearer <token>"
OMNI_ALLOWED_ORIGINS=http://localhost:3000
OMNI_RATE_LIMIT_PER_MIN=60
NODE_ENV=production

# ---- Integrations (one agent each) ----
DATABASE_URL=                          # Neon (read/write role)
DATABASE_URL_READONLY=                 # Neon role with SELECT-only grants (least privilege)
EXA_API_KEY=
AGENTMAIL_API_KEY=
KERNEL_API_KEY=
FLY_API_TOKEN=
FLY_APP_NAME=
ANAM_API_KEY=
ANAM_PERSONA_ID=
EXECUTOR_MCP_URL=
EXECUTOR_API_KEY=
# Learned integrations: add each key the Integration Builder asks for (e.g. ACME_API_KEY=)
